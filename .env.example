# ========================================================
# SynqSquad Environment Variables
# One person finds the one person they want; they talk directly on Gmail.
# Single Auth Path: Supabase Auth (Google Provider configured in Supabase Dashboard)
# ========================================================

PORT=3000
NODE_ENV=production

# App Domain URL
NEXT_PUBLIC_APP_URL=https://synqsquad.app

# Supabase Database & Auth (PostgreSQL + RLS + Google OAuth Provider)
# Use separate projects: synqsquad-test for automated testing, synqsquad-prod for production
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Message Improvement (Server-only, Anthropic API)
# Current model: claude-haiku-5-5
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5

# Operational Flags
MAINTENANCE_MODE=false
